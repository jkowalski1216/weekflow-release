{
  "name": "weekflow",
  "productName": "WeekFlow",
  "version": "1.1.0",
  "description": "WeekFlow: a weekly planner for Windows and Linux.",
  "author": {
    "name": "Josh Kowalski",
    "email": "jkowalski1216@users.noreply.github.com"
  },
  "main": "main.js",
  "private": true,
  "scripts": {
    "dist:win": "electron-builder --win nsis portable --x64"
  },
  "devDependencies": {
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0",
    "resedit": "^3.1.0"
  },
  "build": {
    "appId": "com.weekflow.app",
    "productName": "WeekFlow",
    "copyright": "Copyright \u00a9 2026 WeekFlow",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "app/**/*",
      "package.json"
    ],
    "afterPack": "build/set-exe-icon.js",
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "WeekFlow-${version}-NoInstall.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WeekFlow",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "WeekFlow-Setup.exe",
      "runAfterFinish": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "jkowalski1216",
        "repo": "weekflow-release",
        "releaseType": "release"
      }
    ],
    "electronLanguages": [
      "en-US"
    ],
    "compression": "normal",
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Office",
      "executableName": "weekflow",
      "synopsis": "Weekly planner",
      "description": "Plan your week one day at a time: Mon-Sun board, task statuses, rollover, reminders and streaks.",
      "maintainer": "Josh Kowalski <jkowalski1216@users.noreply.github.com>",
      "desktop": {
        "entry": {
          "StartupWMClass": "WeekFlow",
          "Keywords": "todo;tasks;planner;week;"
        }
      }
    },
    "appImage": {
      "artifactName": "WeekFlow-x86_64.AppImage"
    },
    "deb": {
      "artifactName": "weekflow_amd64.deb",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "repository": "https://github.com/jkowalski1216/weekflow-release",
  "homepage": "https://github.com/jkowalski1216/weekflow-release"
}