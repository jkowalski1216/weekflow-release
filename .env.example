# Copy this file to .env and adjust. Every line is optional.

# Address and port WeekFlow listens on.
HOST=0.0.0.0
PORT=8080

# Where the database lives (weekflow.db plus backups/).
DATA_DIR=data

# Let people create their own accounts. Set to false once everyone has signed up.
ALLOW_SIGNUP=true

# Optional: people need this code to sign up. Leave empty for no code.
INVITE_CODE=

# Set to 1 when WeekFlow sits behind Caddy or nginx on the same machine.
TRUST_PROXY=0

# auto = secure cookies whenever the site is opened over https.
COOKIE_SECURE=auto

# How long people stay signed in, in days.
SESSION_DAYS=30
