{
  "name": "weekflow-web",
  "version": "1.0.0",
  "description": "WeekFlow web app: a weekly planner with accounts, served by a small Node + SQLite backend.",
  "private": true,
  "type": "commonjs",
  "main": "server/server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server/server.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "admin": "node --disable-warning=ExperimentalWarning server/admin.js"
  },
  "dependencies": {
    "express": "5.3.0"
  }
}